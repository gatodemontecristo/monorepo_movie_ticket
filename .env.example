# ==========================================
# MOVIE TICKET BOOKING APP - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your actual values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL database name for the movie ticket app
POSTGRES_DB=movie_ticket

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password (use a strong password in production)
POSTGRES_PASSWORD=your_secure_password

# Database connection URL for Prisma ORM
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/movie_ticket

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Secret key for JWT token signing (use a long, random string)
JWT_SECRET=your_super_secret_jwt_key_here

# ==========================================
# THE MOVIE DATABASE (TMDB) API
# ==========================================
# Get your API key from: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Base URL for TMDB API requests
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3/

# Base URL for TMDB images
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/

# ==========================================
# APPLICATION PORTS & URLs
# ==========================================
# Port for the backend server
BACKEND_PORT=4007

# Port for the frontend Next.js app
FRONTEND_PORT=3009

# Frontend URL for development
FRONTEND_LOCALHOST=http://localhost:3009/

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values above
# 3. Get TMDB API key: https://www.themoviedb.org/settings/api
# 4. Generate strong JWT secret: openssl rand -hex 32
# 5. Set secure database password
# 6. Run: docker-compose up to start the application
